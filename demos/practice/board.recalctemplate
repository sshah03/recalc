# The practice at a glance. Each count re-reads its column, so verifying,
# correcting, or re-running a cell moves the numbers.
progress = = count({B2:F9}) + count({J2:L9}) & ' of 64 answered'
ready_to_file = = countif({C2:C9}, 'Ready to file')
waiting_on_client = = countif({C2:C9}, 'Waiting on client')
in_progress = = countif({C2:C9}, 'In progress')
individuals = = countif({B2:B9}, '1040')
entities = = countif({B2:B9}, '1120-S') + countif({B2:B9}, '1065') + countif({B2:B9}, '1041')
clients_missing_documents = = countif({H2:H9}, '!=none')
missing_documents_total = $ python3 tools/missing_docs.py --count clients # watch: clients/**
ready_but_missing = = countif({I2:I9}, 'Ready but missing documents')
median_effective_rate = = if(count({G2:G9}) < 8, 'waiting', median({G2:G9}))
qbi_eligible = = countif({J2:J9}, 'Yes')
behind_on_estimates = = countif({M2:M9}, 'true')
dana = = countif({D2:D9}, 'Dana')
marcus = = countif({D2:D9}, 'Marcus')
priya = = countif({D2:D9}, 'Priya')
note = ready_but_missing should come back 1: Brennan's status says Ready to file, but the Ridgeline K-1 on last year's return isn't in the folder. Run N3 to draft the request; once a person has run one, the other letters can follow.
# Typed columns: an answer that doesn't fit is refused and asked again, so
# the counts and the rate only ever see the values they expect.
@answer_type B2 B3 B4 B5 B6 B7 B8 B9 = choice:1040|1120-S|1065|1041
@answer_type C2 C3 C4 C5 C6 C7 C8 C9 = choice:In progress|Waiting on client|Ready to file
@answer_type D2 D3 D4 D5 D6 D7 D8 D9 = text
@answer_type E2 E3 E4 E5 E6 E7 E8 E9 F2 F3 F4 F5 F6 F7 F8 F9 K2 K3 K4 K5 K6 K7 K8 K9 L2 L3 L4 L5 L6 L7 L8 L9 = currency
@answer_type J2 J3 J4 J5 J6 J7 J8 J9 = yesno
